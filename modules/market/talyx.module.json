{
  "manifestVersion": 5,
  "id": "market",
  "ai": {"guide": "GUIDE.md"},
  "name": "Market data",
  "version": "2.1.0",
  "description": "Market data: instruments, local history, live data and sources",
  "locales": {"zh-CN": "locales/zh-CN.json"},
  "entries": {
    "backend": "backend.entry",
    "frontend": "frontend/module.tsx"
  },
  "requires": {},
  "panels": {
    "main": {
      "title": "Market",
      "icon": "layers",
      "launcher": true,
      "description": "Local data library, data detail and sources. Open targets: objectId \"data:<instrumentId>\" or \"data:<instrumentId>:<capability>[:<timeframe>]\" opens one data item's detail; \"source:<sourceId>\" opens a source with its key and test; \"job:<jobId>\" shows a fetch job."
    }
  },
  "views": {
    "search_box": {
      "props": {
        "type": "object",
        "properties": {
          "placeholder": {
            "type": "string",
            "maxLength": 128
          },
          "query": {
            "type": "string",
            "maxLength": 128
          },
          "markets": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/MarketCode"
            }
          },
          "venues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "environment": {
            "type": "string", "enum": ["production", "testnet", "demo"]
          },
          "constraint": {
            "$ref": "#/$defs/TradeSearchConstraint"
          },
          "currentInstrumentId": {
            "type": "string",
            "description": "The host's current instrument (the chart's symbol); its row is marked in the results."
          },
          "callerActions": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "activeInstrumentIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "emits": {
        "selected": {
          "type": "object",
          "properties": {
            "instrument": {
              "$ref": "#/$defs/Instrument"
            },
            "series": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SeriesId"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Set when the user picked an imported dataset or a derived value series instead of the instrument itself."
            }
          },
          "required": [
            "instrument",
            "series"
          ],
          "additionalProperties": false
        },
        "caller_action": {
          "type": "object",
          "properties": {
            "actionId": {
              "type": "string"
            },
            "instrument": {
              "$ref": "#/$defs/Instrument"
            }
          },
          "required": [
            "actionId",
            "instrument"
          ],
          "additionalProperties": false
        },
        "closed": {
          "type": "object",
          "additionalProperties": false
        }
      }
    },
    "sources_settings": {
      "description": "Market's page in the settings window: its sources, each on or off, with its key and settings.",
      "props": {
        "type": "object",
        "additionalProperties": false
      }
    }
  },
  "provides": {
    "platform.settings_section": [
      {
        "id": "sources",
        "descriptor": {
          "title": "Sources",
          "view": "sources_settings"
        }
      }
    ],
    "market.data_source": [
      {
        "id": "yfinance",
        "descriptor": {
          "name": "Yahoo Finance",
          "sourceIds": [
            "yfinance"
          ],
          "kinds": [
            "bars",
            "quotes",
            "actions",
            "classification",
            "shares"
          ],
          "assetClasses": [
            "equity",
            "fund",
            "index",
            "fx",
            "commodity",
            "rate"
          ],
          "credentials": "none",
          "paid": false,
          "supports": [
            "search",
            "history",
            "live",
            "research"
          ]
        }
      },
      {
        "id": "ccxt",
        "descriptor": {
          "name": "Crypto exchanges",
          "sourceIds": [
            "binance",
            "bitfinex",
            "bitget",
            "bybit",
            "coinbase",
