+// Copyright (C) 2026 Nautech Systems Pty Ltd. LGPL-3.0-or-later.
+//! Generic simulated-venue trading conditions and their narrow recovery state.
+use std::{cell::RefCell, collections::BTreeMap, fmt, rc::Rc};
+
+use anyhow::ensure;
+use nautilus_common::{cache::Cache, clock::Clock};
+use nautilus_model::{data::Bar, instruments::{Instrument, InstrumentAny}, orders::{Order, OrderAny}, types::{Currency, Money, Price, Quantity}};
+use rust_decimal::Decimal;
+use serde::{Deserialize, Serialize};
+
+use crate::models::fee::{FeeModel, FeeModelHandle};
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Commission {
+    pub rate: Decimal,
+    pub per_share: Decimal,
+    pub minimum: Decimal,
+    pub maximum_rate: Option<Decimal>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ExecutionBar {
+    pub open: Decimal,
+    pub high: Decimal,
+    pub low: Decimal,
+    pub close: Decimal,
+    pub volume: Decimal,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Session {
+    pub date: String,
+    pub open_at: u64,
+    pub close_at: u64,
+    pub lower: Option<Decimal>,
+    pub upper: Option<Decimal>,
+    pub price_increment: Decimal,
+    pub price_origin: Decimal,
+    pub price_tolerance: Decimal,
+    pub buy_tax_rate: Decimal,
+    pub sell_tax_rate: Decimal,
+    pub input_price_scale: Decimal,
+    pub input_price_offset: Decimal,
+    pub input_price_increment: Option<Decimal>,
+    pub input_volume_scale: Decimal,
+    pub execution_bar: Option<ExecutionBar>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct TradingRules {
+    pub minimum: Decimal,
+    pub increment: Decimal,
+    pub odd_lot_sell_all: bool,
+    pub sell_after_sessions: u8,
+    pub commission: Commission,
+    pub sessions: Vec<Session>,
+}
+
+impl TradingRules {
+    fn validate(&self) -> anyhow::Result<()> {
+        ensure!(self.minimum > Decimal::ZERO && self.increment > Decimal::ZERO, "Trading quantity minimum and increment must be positive");
+        ensure!(self.sell_after_sessions <= 1, "Only same-session or next-session resale is supported");
+        let fee = &self.commission;
+        ensure!(fee.rate >= Decimal::ZERO && fee.per_share >= Decimal::ZERO && fee.minimum >= Decimal::ZERO && fee.maximum_rate.is_none_or(|v| v >= Decimal::ZERO), "Trading commission cannot be negative");
+        let mut previous = None;
+        for session in &self.sessions {
+            ensure!(session.date.len() == 10 && session.open_at < session.close_at && session.price_increment > Decimal::ZERO && session.price_tolerance >= Decimal::ZERO, "Invalid trading session or price increment");
+            ensure!(session.lower.is_some() == session.upper.is_some() && session.lower.zip(session.upper).is_none_or(|(a,b)| a < b), "Price limits require an ordered pair or explicit no-limit");
+            ensure!(session.buy_tax_rate >= Decimal::ZERO && session.sell_tax_rate >= Decimal::ZERO, "Trading taxes cannot be negative");
+            ensure!(session.input_price_scale > Decimal::ZERO && session.input_volume_scale > Decimal::ZERO && session.input_price_increment.is_none_or(|value| value > Decimal::ZERO), "Invalid market input coordinate");
+            ensure!(previous.is_none_or(|end| end <= session.open_at), "Trading sessions must be ordered and disjoint");
+            if let Some(bar) = &session.execution_bar {
+                ensure!(bar.open > Decimal::ZERO && bar.low > Decimal::ZERO && bar.high >= bar.open && bar.high >= bar.close && bar.low <= bar.open && bar.low <= bar.close && bar.volume >= Decimal::ZERO, "Invalid execution observation");
+            }
+            previous = Some(session.close_at);
+        }
+        ensure!(!self.sessions.is_empty(), "Trading session evidence is empty");
+        Ok(())
+    }
+
+    fn session(&self, now: u64) -> anyhow::Result<&Session> {
+        self.sessions.iter().find(|session| session.open_at <= now && now <= session.close_at)
+            .ok_or_else(|| anyhow::anyhow!("No verified trading conditions at {now}"))
+    }
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct OrderBill {
+    pub quantity: Decimal,
+    pub size_quantity: Decimal,
+    pub notional: Decimal,
+    pub commission_paid: Decimal,
+    pub tax_accrued: Decimal,
+    pub tax_paid: Decimal,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct TradingState {
+    pub session_date: Option<String>,
+    pub last_market_at: u64,
+    pub quantity: Decimal,
+    pub frozen: Decimal,
+    pub bills: BTreeMap<String, OrderBill>,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RebuildOrder {
+    pub order_id: String,
+    pub side: String,
+    pub quantity: Decimal,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct RebuildSeed { at: u64, price: Decimal }
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Input {
+    rules: TradingRules,
+    state: Option<TradingState>,
+    rebuild_orders: Vec<RebuildOrder>,
+    rebuild_seed: Option<RebuildSeed>,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct Conditions {
+    rules: Rc<RefCell<TradingRules>>,
+    state: Rc<RefCell<TradingState>>,
+    rebuild: Rc<RefCell<BTreeMap<String, RebuildOrder>>>,
+    initial: TradingState,
+    initial_rebuild: BTreeMap<String, RebuildOrder>,
+    rebuild_seed: Option<RebuildSeed>,
+    last_update: Rc<RefCell<Option<Vec<u8>>>>,
+}
+
+#[derive(Clone, Debug)]
+struct Parts {
+    commission: Decimal,
+    tax: Decimal,
+    accrued: Decimal,
+    total: Money,
+}
+
+impl Conditions {
+    pub(crate) fn parse(raw: &str) -> anyhow::Result<Self> {
+        let input: Input = serde_json::from_str(raw)?;
+        input.rules.validate()?;
+        let state = input.state.unwrap_or_default();
+        ensure!(state.quantity >= Decimal::ZERO && state.frozen >= Decimal::ZERO && state.frozen <= state.quantity, "Invalid restored inventory/frozen quantity");
+        ensure!(state.bills.values().all(|bill| bill.quantity >= Decimal::ZERO && bill.size_quantity >= Decimal::ZERO && bill.notional >= Decimal::ZERO && bill.commission_paid >= Decimal::ZERO && bill.tax_accrued >= Decimal::ZERO && bill.tax_paid >= Decimal::ZERO), "Invalid restored order fee state");
+        let mut rebuild = BTreeMap::new();
+        let mut total = Decimal::ZERO;
+        for order in input.rebuild_orders {
+            ensure!(order.side == "BUY" && order.quantity > Decimal::ZERO, "Rebuilding requires exact pre-existing long inventory");
+            total += order.quantity;
+            ensure!(rebuild.insert(order.order_id.clone(), order).is_none(), "Duplicate authorized rebuild order");
+        }
+        ensure!(total <= state.quantity, "Rebuild quantity exceeds restored inventory");
+        ensure!(input.rebuild_seed.as_ref().is_none_or(|seed| seed.at > 0 && seed.price > Decimal::ZERO), "Invalid internal rebuild seed");
+        ensure!(rebuild.is_empty() || input.rebuild_seed.is_some(), "Authorized rebuild needs its exact seed observation");
+        Ok(Self { rules: Rc::new(RefCell::new(input.rules)), state: Rc::new(RefCell::new(state.clone())), rebuild: Rc::new(RefCell::new(rebuild.clone())), initial_rebuild: rebuild, rebuild_seed: input.rebuild_seed, initial: state, last_update: Rc::new(RefCell::new(None)) })
+    }
+
+    pub(crate) fn reset(&self) {
+        *self.state.borrow_mut() = self.initial.clone();
+        *self.rebuild.borrow_mut() = self.initial_rebuild.clone();
+    }
+
+    pub(crate) fn fee_model(&self, clock: Rc<RefCell<dyn Clock>>) -> FeeModelHandle {
+        FeeModelHandle::new(ConditionsFeeModel { conditions: self.clone(), clock })
+    }
+
+    pub(crate) fn synchronize(&self, cache: &Rc<RefCell<Cache>>, id: &str) -> anyhow::Result<()> {
+        if let Some(value) = cache.borrow().get(&format!("trading-conditions/rules/{id}"))? {
+            let bytes = value.to_vec();
+            if self.last_update.borrow().as_ref() != Some(&bytes) {
+                let rules: TradingRules = serde_json::from_slice(&bytes)?;
+                rules.validate()?;
+                *self.rules.borrow_mut() = rules;
+                *self.last_update.borrow_mut() = Some(bytes);
+            }
+        }
+        self.publish(cache, id)
+    }
+
+    pub(crate) fn observe(&self, now: u64) -> anyhow::Result<()> {
+        if now < self.state.borrow().last_market_at { return Ok(()); }
+        self.state.borrow_mut().last_market_at = now;
+        let rules = self.rules.borrow();
+        let session = rules.session(now)?;
+        let mut state = self.state.borrow_mut();
+        if state.session_date.as_ref().is_none_or(|day| day < &session.date) {
+            state.session_date = Some(session.date.clone());
+            state.frozen = Decimal::ZERO;
+        }
+        Ok(())
+    }
+
+    fn market_time(&self, fallback: u64) -> u64 {
+        let observed = self.state.borrow().last_market_at;
+        if observed == 0 { fallback } else { observed }
+    }
+
+    pub(crate) fn publish(&self, cache: &Rc<RefCell<Cache>>, id: &str) -> anyhow::Result<()> {
+        let value = serde_json::to_vec(&*self.state.borrow())?;
+        cache.borrow_mut().add(&format!("trading-conditions/state/{id}"), value.into())
+    }
+
+    pub(crate) fn input_bar(&self, bar: Bar) -> anyhow::Result<Bar> {
+        let mut result = bar;
+        if let Some(seed) = &self.rebuild_seed
+            && seed.at == bar.ts_event.as_u64() && !self.rebuild.borrow().is_empty() {
+            let price = Price::from_decimal_dp(seed.price, bar.close.precision)?;
+            result.open = price;
+            result.high = price;
+            result.low = price;
+            result.close = price;
+            let quantity: Decimal = self.rebuild.borrow().values().map(|order| order.quantity).sum();
+            result.volume = Quantity::from_decimal_dp(quantity * Decimal::from(4), bar.volume.precision)?;
+            return Ok(result);
+        }
+        let rules = self.rules.borrow();
+        let session = rules.session(bar.ts_event.as_u64())?;
+        if let Some(observed) = &session.execution_bar {
+            ensure!(bar.ts_event.as_u64() == session.close_at, "Execution observation timestamp mismatch");
+            result.open = Price::from_decimal_dp(observed.open, bar.open.precision)?;
+            result.high = Price::from_decimal_dp(observed.high, bar.high.precision)?;
+            result.low = Price::from_decimal_dp(observed.low, bar.low.precision)?;
+            result.close = Price::from_decimal_dp(observed.close, bar.close.precision)?;
+            result.volume = Quantity::from_decimal_dp(observed.volume, bar.volume.precision)?;
+        } else {
+            result.open = self.input_price(bar.open, bar.ts_event.as_u64())?;
+            result.high = self.input_price(bar.high, bar.ts_event.as_u64())?;
+            result.low = self.input_price(bar.low, bar.ts_event.as_u64())?;
+            result.close = self.input_price(bar.close, bar.ts_event.as_u64())?;
+            result.volume = self.input_quantity(bar.volume, bar.ts_event.as_u64())?;
+        }
+        Ok(result)
+    }
+
+    pub(crate) fn input_price(&self, price: Price, at: u64) -> anyhow::Result<Price> {
+        let rules = self.rules.borrow();
+        let session = rules.session(at)?;
+        let mut value = price.as_decimal() * session.input_price_scale + session.input_price_offset;
+        if let Some(increment) = session.input_price_increment {
+            value = (value / increment).round() * increment;
+        }
+        Ok(Price::from_decimal_dp(value, price.precision)?)
+    }
+
+    pub(crate) fn input_quantity(&self, quantity: Quantity, at: u64) -> anyhow::Result<Quantity> {
+        let rules = self.rules.borrow();
+        let value = quantity.as_decimal() * rules.session(at)?.input_volume_scale;
+        ensure!(value.fract().is_zero() || quantity.precision != 0, "Restored market volume is fractional");
+        Ok(Quantity::from_decimal_dp(value, quantity.precision)?)
+    }
+
+    fn rebuilding(&self, order: &OrderAny) -> bool {
+        self.rebuild.borrow().get(order.client_order_id().as_str()).is_some_and(|authorization| authorization.side == order.order_side().to_string())
+    }
+
+    pub(crate) fn validate_quantity(&self, order: &OrderAny, total: Quantity, filled: Quantity) -> anyhow::Result<()> {
+        if self.rebuilding(order) {
+            let authorized = self.rebuild.borrow();
+            ensure!(total.as_decimal() - filled.as_decimal() <= authorized[order.client_order_id().as_str()].quantity, "Order exceeds exact rebuild authorization");
+            return Ok(());
+        }
+        ensure!(self.rebuild.borrow().is_empty(), "Inventory rebuild has not finished");
+        let rules = self.rules.borrow();
+        let state = self.state.borrow();
+        let carried = state.bills.get(order.client_order_id().as_str()).map_or(Decimal::ZERO, |bill| (bill.size_quantity - filled.as_decimal()).max(Decimal::ZERO));
+        let quantity = total.as_decimal() + carried;
+        let remainder = (total.as_decimal() - filled.as_decimal()).max(Decimal::ZERO);
+        if order.is_sell() && rules.odd_lot_sell_all && remainder == state.quantity { return Ok(()); }
+        ensure!(quantity >= rules.minimum && (quantity - rules.minimum) % rules.increment == Decimal::ZERO, "Quantity {quantity} violates minimum {} / increment {}", rules.minimum, rules.increment);
+        ensure!(!order.is_sell() || remainder <= state.quantity, "Sell quantity exceeds owned inventory");
+        Ok(())
+    }
+
+    pub(crate) fn maximum_quantity(&self, order: &OrderAny, quantity: Quantity) -> anyhow::Result<Quantity> {
+        let available = if self.rebuilding(order) {
+            self.rebuild.borrow()[order.client_order_id().as_str()].quantity
+        } else if order.is_sell() {
+            let state = self.state.borrow();
+            (state.quantity - state.frozen).max(Decimal::ZERO)
+        } else { quantity.as_decimal() };
+        Ok(Quantity::from_decimal_dp(quantity.as_decimal().min(available), quantity.precision)?)
+    }
+
+    pub(crate) fn fill_quantity(&self, order: &OrderAny, price: Price, quantity: Quantity, now: u64) -> anyhow::Result<Option<Quantity>> {
+        if self.rebuilding(order) {
+            let authorized = self.rebuild.borrow()[order.client_order_id().as_str()].quantity;
+            return Ok(Some(Quantity::from_decimal_dp(quantity.as_decimal().min(authorized),quantity.precision)?));
+        }
+        let rules = self.rules.borrow();
+        let session = rules.session(self.market_time(now))?;
+        let price = price.as_decimal();
+        if order.is_buy() && session.upper.is_some_and(|upper| price >= upper - session.price_tolerance)
+            || order.is_sell() && session.lower.is_some_and(|lower| price <= lower + session.price_tolerance) { return Ok(None); }
+        let state = self.state.borrow();
+        let available = if order.is_sell() { (state.quantity - state.frozen).max(Decimal::ZERO) } else { quantity.as_decimal() };
+        let amount = quantity.as_decimal().min(available);
+        if amount <= Decimal::ZERO { return Ok(None); }
+        Ok(Some(Quantity::from_decimal_dp(amount, quantity.precision)?))
+    }
+
+    pub(crate) fn validate_prices(&self, order: &OrderAny, price: Option<Price>, trigger: Option<Price>, now: u64) -> anyhow::Result<()> {
+        if self.rebuilding(order) { return Ok(()); }
+        let rules = self.rules.borrow();
+        let session = rules.session(self.market_time(now))?;
+        for price in [price, trigger].into_iter().flatten() {
+            let value = price.as_decimal();
+            let rounded = ((value-session.price_origin)/session.price_increment).round()*session.price_increment+session.price_origin;
+            ensure!((value-rounded).abs() <= session.price_tolerance + Decimal::new(1,12), "Order price violates the session price increment");
+        }
+        Ok(())
+    }
+
+    fn parts(&self, order: &OrderAny, quantity: Quantity, price: Price, currency: Currency, now: u64) -> anyhow::Result<Parts> {
+        if self.rebuilding(order) {
+            return Ok(Parts { commission: Decimal::ZERO, tax: Decimal::ZERO, accrued: Decimal::ZERO, total: Money::from_decimal(Decimal::ZERO, currency)? });
+        }
+        let rules = self.rules.borrow();
+        let session = rules.session(self.market_time(now))?;
+        let state = self.state.borrow();
+        let zero = OrderBill::default();
+        let previous = state.bills.get(order.client_order_id().as_str()).unwrap_or(&zero);
+        let notional = quantity.as_decimal() * price.as_decimal();
+        let cumulative = previous.notional + notional;
+        let fee = &rules.commission;
+        let mut total = (cumulative * fee.rate + (previous.quantity + quantity.as_decimal()) * fee.per_share).max(fee.minimum);
+        if let Some(cap) = fee.maximum_rate { total = total.min(cumulative * cap); }
+        let commission = (Money::from_decimal(total, currency)?.as_decimal() - previous.commission_paid).max(Decimal::ZERO);
+        let accrued = previous.tax_accrued + notional * if order.is_buy() { session.buy_tax_rate } else { session.sell_tax_rate };
+        let tax = (Money::from_decimal(accrued, currency)?.as_decimal() - previous.tax_paid).max(Decimal::ZERO);
+        Ok(Parts { commission, tax, accrued, total: Money::from_decimal(commission + tax, currency)? })
+    }
+
+    pub(crate) fn record_fill(&self, order: &OrderAny, quantity: Quantity, price: Price, currency: Currency, now: u64) -> anyhow::Result<()> {
+        if self.rebuilding(order) {
+            let key = order.client_order_id().to_string();
+            let mut rebuild = self.rebuild.borrow_mut();
+            let authorized = rebuild.get_mut(&key).expect("checked rebuild authorization");
+            ensure!(quantity.as_decimal() <= authorized.quantity, "Rebuild fill exceeds authorization");
+            authorized.quantity -= quantity.as_decimal();
+            if authorized.quantity.is_zero() { rebuild.remove(&key); }
+            return Ok(());
+        }
+        let parts = self.parts(order, quantity, price, currency, now)?;
+        let mut state = self.state.borrow_mut();
+        let bill = state.bills.entry(order.client_order_id().to_string()).or_default();
+        bill.quantity += quantity.as_decimal();
+        bill.size_quantity += quantity.as_decimal();
+        bill.notional += quantity.as_decimal() * price.as_decimal();
+        bill.commission_paid += parts.commission;
+        bill.tax_accrued = parts.accrued;
+        bill.tax_paid += parts.tax;
+        if order.is_buy() {
+            state.quantity += quantity.as_decimal();
+            if self.rules.borrow().sell_after_sessions != 0 { state.frozen += quantity.as_decimal(); }
+        } else {
+            state.quantity -= quantity.as_decimal();
+        }
+        ensure!(state.quantity >= state.frozen && state.frozen >= Decimal::ZERO, "Trading settlement state would become inconsistent");
+        Ok(())
+    }
+}
+
+struct ConditionsFeeModel { conditions: Conditions, clock: Rc<RefCell<dyn Clock>> }
+impl fmt::Debug for ConditionsFeeModel {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { f.write_str("TradingConditionsFeeModel") }
+}
+impl FeeModel for ConditionsFeeModel {
+    fn get_commission(&self, order: &OrderAny, quantity: Quantity, price: Price, instrument: &InstrumentAny) -> anyhow::Result<Money> {
+        Ok(self.conditions.parts(order, quantity, price, instrument.quote_currency(), self.clock.borrow().timestamp_ns().as_u64())?.total)
+    }
+}
+
+/// Estimate the remaining cash charge using the same model as final matching.
+///
+/// # Errors
+/// Returns an error for malformed conditions or an unverified session.
+pub fn estimate_order_fee(raw: &str, order: &OrderAny, quantity: Quantity, price: Price, currency: Currency, now: u64, state: Option<&[u8]>, rules: Option<&[u8]>) -> anyhow::Result<Money> {
+    let conditions = Conditions::parse(raw)?;
+    if let Some(state) = state { *conditions.state.borrow_mut() = serde_json::from_slice(state)?; }
+    if let Some(rules) = rules {
+        let parsed: TradingRules = serde_json::from_slice(rules)?;
+        parsed.validate()?;
+        *conditions.rules.borrow_mut() = parsed;
+    }
+    Ok(conditions.parts(order, quantity, price, currency, now)?.total)
+}
+
+/// Validate a serialized rules update before it enters a simulated venue.
+///
+/// # Errors
+/// Returns an error for missing fields, negative rates, or overlapping sessions.
+pub fn validate_rules(raw: &str) -> anyhow::Result<()> {
+    let rules: TradingRules = serde_json::from_str(raw)?;
+    rules.validate()
+}
+
+/// Map an observed market price to the simulated venue's execution coordinate.
+///
+/// # Errors
+/// Returns an error if the input coordinate or its dated evidence is invalid.
+pub fn estimate_input_price(raw: &str, price: Price, now: u64, state: Option<&[u8]>, rules: Option<&[u8]>) -> anyhow::Result<Price> {
+    let conditions = Conditions::parse(raw)?;
+    if let Some(state) = state { *conditions.state.borrow_mut() = serde_json::from_slice(state)?; }
+    if let Some(rules) = rules {
+        let parsed: TradingRules = serde_json::from_slice(rules)?;
+        parsed.validate()?;
+        *conditions.rules.borrow_mut() = parsed;
+    }
+    let at = conditions.market_time(now);
+    {
+        let rules = conditions.rules.borrow();
+        if let Some(bar) = &rules.session(at)?.execution_bar {
+            return Ok(Price::from_decimal_dp(bar.close, price.precision)?);
+        }
+    }
+    conditions.input_price(price, at)
+}
