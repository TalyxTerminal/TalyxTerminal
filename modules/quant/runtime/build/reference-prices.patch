+            };
+
+            if let Some(instrument) = instrument {
+                self.add_instrument(instrument)?;
+            } else {
+                anyhow::bail!(
+                    "No matching engine found for instrument {}",
+                    index.instrument_id
+                );
+            }
+        }
+
+        if let Some(matching_engine) = self.matching_engines.get_mut(&index.instrument_id) {
+            matching_engine.process_index_price(index);
+        } else {
+            anyhow::bail!("Matching engine should be initialized");
+        }
+
+        self.drain_oto_commands();
+        Ok(())
+    }
 
