  "search_web": {
   "description": "Search current sources or read an exact HTTP(S) page. mode=search requires query and optionally objective;\nmode=page requires url. Uses the configured search source or supported provider search and records its actual\nusage; errors never switch sources. Cite observed URLs directly as Markdown links. Examples:\n{\"mode\":\"search\",\"query\":\"BTC market news\"}; {\"mode\":\"page\",\"url\":\"https://example.org/report\"}.",
   "effects": [
    "read",
    "external"
   ],
   "task": false,
   "input": {
    "$ref": "#/$defs/SearchWebInput"
